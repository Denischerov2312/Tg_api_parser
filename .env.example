# Скопируйте этот файл в .env и вставьте свои значения с my.telegram.org
API_ID=123456
API_HASH=your_api_hash

# Сколько дней назад смотреть при первом запуске
DAYS_BACK=30
# Максимум сообщений с одного канала за запуск
LIMIT_PER_CHANNEL=400

# 1 = только онлайн/гибрид, 0 = все соревнования
ONLY_ONLINE=0
# Посты короче этого (в символах) не отправляются в нейросеть
MIN_TEXT_LEN=150

# Нейросеть (OpenAI-совместимый API, по умолчанию DeepSeek через ProxyAPI)
DEEPSEEK_API_KEY=your_proxyapi_key
LLM_BASE_URL=https://api.proxyapi.ru/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Сколько запросов к нейросети отправлять одновременно
LLM_CONCURRENCY=5

# Порог похожести названий (0..1) для автоматической склейки дублей с одинаковой датой
TITLE_SIMILARITY=0.85
